{
  "name": "tearoom1/kirby-content-watch",
  "description": "Kirby plugin that allows you to keep track of what has been changed and by whom.",
  "type": "kirby-plugin",
  "license": "MIT",
  "homepage": "https://github.com/tearoom1/kirby-content-watch",
  "version": "3.12.0",
  "keywords": [
    "kirby",
    "panel",
    "content",
    "history"
  ],
  "authors": [
    {
      "name": "Mathis Koblin",
      "email": "mail@tearoom.one",
      "homepage": "https://www.tearoom.one",
      "role": "Maintainer"
    }
  ],
  "support": {
    "docs": "https://github.com/tearoom1/kirby-content-watch/blob/main/README.md",
    "source": "https://github.com/tearoom1/kirby-content-watch"
  },
  "funding": [
    {
      "type": "custom",
      "url": "https://www.tearoom.one/en/kirby-plugins/support"
    },
    {
      "type": "Buy me a coffee",
      "url": "https://buymeacoffee.com/tearoom1"
    },
    {
      "type": "Github Sponsors",
      "url": "https://github.com/sponsors/tearoom1"
    }
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/tearoom1/kirby-content-watch.git"
  },
  "require": {
    "php": ">=8.1",
    "getkirby/composer-installer": "^1.2"
  },
  "conflict": {
    "getkirby/cms": "<4.0"
  },
  "require-dev": {
    "getkirby/cms": "^4.0 || ^5.0",
    "phpunit/phpunit": "^11.0 || ^12.0"
  },
  "autoload": {
    "psr-4": {
      "TearoomOne\\ContentWatch\\": "src/"
    }
  },
  "scripts": {
    "test": "phpunit --configuration phpunit.xml --testdox"
  },
  "config": {
    "optimize-autoloader": true,
    "allow-plugins": {
      "getkirby/composer-installer": true
    }
  }
}
